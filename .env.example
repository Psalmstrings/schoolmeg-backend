# Server Environment
NODE_ENV=development
PORT=5000

# Database
# For local MongoDB: mongodb://127.0.0.1:27017/schoolmag
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/schoolmag?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/schoolmag

# Security & JWT
JWT_SECRET=replace_this_with_a_long_random_secure_secret_in_production
JWT_EXPIRES_IN=7d
COOKIE_MAX_AGE_DAYS=7

# Client Origin
FRONTEND_URL=http://localhost:5173

# Cloudinary (Media / Passport Photos)
# Obtain these from your Cloudinary Console (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=schoolmag_uploads

# Rate Limiting
RATE_LIMIT_MAX=200
